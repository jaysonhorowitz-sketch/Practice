# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# App credentials (single user for this internal tool)
APP_USERNAME=admin
APP_PASSWORD=changeme

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── ElevenLabs ───────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ─── HeyGen ───────────────────────────────────────────────────────────────────
HEYGEN_API_KEY=...
HEYGEN_AVATAR_ID=...

# ─── Cloudflare R2 / S3 ───────────────────────────────────────────────────────
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=ugc-studio

# ─── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=generate-with-openssl-rand-base64-32

# ─── Mock Mode ────────────────────────────────────────────────────────────────
# Set to "true" to run the full pipeline without real API keys.
# All external calls (OpenAI, ElevenLabs, HeyGen, R2) return canned responses.
MOCK_MODE=true
